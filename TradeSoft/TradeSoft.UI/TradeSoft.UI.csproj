<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TradeSoft.Engine\TradeSoft.Engine.csproj" />
    <ProjectReference Include="..\TradeSoft.Infrastructure\TradeSoft.Infrastructure.csproj" />
    <ProjectReference Include="..\TradeSoft.Core\TradeSoft.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<NoWarn>NU1701;$(NoWarn)</NoWarn>
  </PropertyGroup>

</Project>
