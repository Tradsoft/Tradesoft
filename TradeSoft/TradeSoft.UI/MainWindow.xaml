<Window x:Class="TradeSoft.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:vm="clr-namespace:TradeSoft.UI.ViewModels"
        Title="TradeSoft Pro" Height="850" Width="1400"
        Background="#131722" Foreground="#D1D4DC"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2E39"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2E39"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#787B86"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E3EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E222D" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
            <Grid>
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="TRADESOFT" FontSize="24" FontWeight="Bold" Foreground="#2962FF" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                        <TextBlock Text="DATA RANGE" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start" Foreground="#B2B5BE" FontSize="11" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="End" Foreground="#B2B5BE" FontSize="11" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding EndDate}" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="STRATEGY" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding StrategyNames}" SelectedItem="{Binding SelectedStrategyName}" Height="35" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <TextBlock Text="PARAMETERS" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="BROKER / ACCOUNT" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,20,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Initial Cash ($)" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding InitialCash}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Leverage (x)" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding Leverage}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Commission ($/lot)" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding Commission}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Slippage (pips)" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding Slippage}"/>
                        </Grid>

                        <TextBlock Text="RISK MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,20,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Risk / Trade (%)" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxRiskPerTrade}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Positions" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxPositions}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Drawdown (%)" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxDrawdown}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Daily Loss Limit (%)" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxDailyLoss}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Min Risk/Reward" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                            <TextBox Grid.Column="1" Text="{Binding MinRiskReward}"/>
                        </Grid>

                        <Button Command="{Binding RunBacktestCommand}" Content="RUN BACKTEST" 
                                Background="#2962FF" Foreground="White" Height="40" Margin="0,30,0,20" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#131722">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1" Padding="15,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding AvailableTimeframes}" 
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedTimeframe}"
                                  Width="70" Height="28" Margin="0,0,10,0"/>

                        <Grid VerticalAlignment="Center">
                            <ComboBox x:Name="CbxIndicators"
                                      ItemsSource="{Binding AvailableIndicators}" 
                                      Width="160" Height="30" 
                                      VerticalContentAlignment="Center"
                                      Background="White"
                                      DropDownClosed="CbxIndicators_DropDownClosed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" 
                                                  IsChecked="{Binding IsSelected}" 
                                                  Foreground="Black"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"
                                                  Margin="2"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="📈 Indicateurs ▾" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Left" 
                                       Margin="12,0,0,0" 
                                       Foreground="#333333"
                                       FontWeight="SemiBold"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#B2B5BE"
                               FontSize="12"
                               FontFamily="Consolas"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="250"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <scott:WpfPlot x:Name="MainPlot"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,5,0,0" IsHitTestVisible="False">
                            <TextBlock x:Name="TxtOHLC" Text="" Foreground="#D1D4DC" FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="#E1E1E1" BorderThickness="0,1,1,0">
                        <Grid Background="White">
                            <scott:WpfPlot x:Name="EquityPlot"/>
                            <TextBlock Text="Equity Curve" Foreground="#333333" FontSize="13" FontWeight="Bold" Margin="50,5,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
                            <StackPanel x:Name="EquityInfoPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,15,0" IsHitTestVisible="False">
                                <TextBlock x:Name="TxtCrosshairInfo" Text="" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="#1E222D" BorderBrush="#2B2B2B" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="JOURNAL D'ACTIVITÉ" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="15,0" VerticalAlignment="Center"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2B2B2B" BorderThickness="0,0,0,1" Padding="5,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Time}" Foreground="#555555" FontSize="10" FontFamily="Consolas" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Type}" Foreground="{Binding Color}" FontSize="10" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Message}" Foreground="#D1D4DC" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0" Padding="15" Background="#1E222D">
                            <StackPanel>
                                <TextBlock Text="RÉSULTATS" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,0,0,15"/>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Initial Cash" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValInitialCash" Text="-" Style="{StaticResource StatValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Final Equity" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValFinalEquity" Text="-" Style="{StaticResource StatValueStyle}"/>
                                </Grid>
                                <Separator Background="#2B2B2B" Margin="0,5"/>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Net Profit" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValNetProfit" Text="-" Style="{StaticResource StatValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Return %" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValReturn" Text="-" Style="{StaticResource StatValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Max Drawdown" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValMaxDD" Text="-" Style="{StaticResource StatValueStyle}" Foreground="#FF1744"/>
                                </Grid>
                                <Separator Background="#2B2B2B" Margin="0,5"/>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Total Trades" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValTotalTrades" Text="-" Style="{StaticResource StatValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Win Rate" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValWinRate" Text="-" Style="{StaticResource StatValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Profit Factor" Style="{StaticResource StatLabelStyle}"/>
                                    <TextBlock x:Name="ValProfitFactor" Text="-" Style="{StaticResource StatValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>