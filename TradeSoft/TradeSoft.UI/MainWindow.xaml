<Window x:Class="TradeSoft.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:vm="clr-namespace:TradeSoft.UI.ViewModels"
        Title="TradeSoft Pro" Height="768" Width="1366"
        Background="#131722" Foreground="#D1D4DC"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2E39"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2E39"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E222D" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
            <Grid>
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="TRADESOFT" FontSize="24" FontWeight="Bold" Foreground="#2962FF" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                        <TextBlock Text="DATA RANGE" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start" Foreground="#B2B5BE" FontSize="11" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="End" Foreground="#B2B5BE" FontSize="11" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding EndDate}" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="STRATEGY" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding StrategyNames}" SelectedItem="{Binding SelectedStrategyName}" Height="35" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <TextBlock Text="PARAMETERS" FontSize="11" FontWeight="Bold" Foreground="#5D606B" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#E0E3EB"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border VerticalAlignment="Bottom" Background="#181B24" Height="30" Padding="10,0">
                    <Grid>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11" Foreground="#2962FF"/>
                        <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#2962FF" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#131722">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1" Padding="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EURUSD" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <ComboBox ItemsSource="{Binding AvailableTimeframes}" SelectedItem="{Binding SelectedTimeframe}" Width="100" Height="28"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <scott:WpfPlot x:Name="MainPlot"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,5,0,0" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtOHLC" Text="" Foreground="#D1D4DC" FontSize="12" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>